# Browser origins for local frontend development, as a JSON array without trailing slashes.
SURFACESIGNAL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Optional absolute repository/data root for native Python/CLI only.
# SURFACESIGNAL_ROOT=/absolute/path/to/nsac26-dancing-with-the-sars

# Earthdata is needed only for CLI downloads. Use ~/.netrc or export EARTHDATA_TOKEN.

# Public site/data consultation is static and requires none of these credentials.
SURFACESIGNAL_DATA_MODE=static
# Optional anonymous full-snapshot manifest URL after an owner-approved release.
# SURFACESIGNAL_SNAPSHOT_MANIFEST=https://example.org/snapshots/snapshot-manifest.json
# Optional backend-only authenticated integrations; never use NEXT_PUBLIC_* for secrets.
# SURFACESIGNAL_EARTHDATA_TOKEN=
# SURFACESIGNAL_ANA_API_TOKEN=
# Legacy EARTHDATA_TOKEN and ANA_API_TOKEN names are accepted too.
# No ANA collector is automatically enabled by providing a token.
# CLI --root uses <root>/.env. Default CLI reads repository/current-directory .env.
