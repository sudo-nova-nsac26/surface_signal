# Optional backend/root configuration. The default static public site requires no .env.
# FastAPI origins must be exact. CORS is not authentication.
SURFACESIGNAL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional root for Python/CLI; otherwise automatically detected.
# SURFACESIGNAL_ROOT=/absolute/path/to/surface_signal

# Optional backend setting; DOES NOT select the Next.js data mode.
# SURFACESIGNAL_DATA_MODE=static
# Optional already-public full snapshot manifest; leave empty until published.
# SURFACESIGNAL_SNAPSHOT_MANIFEST=https://approved-host.example/snapshot-manifest.json

# CLI-only authorized NASA Earthdata access. Prefer ~/.netrc mode 0600.
# Full account setup, authentication, download, verification: docs/earthdata-access.md
# SURFACESIGNAL_EARTHDATA_TOKEN=
# EARTHDATA_TOKEN=                    # accepted legacy alias
# Optional backend-only integration; supplying a token does not enable ANA collection.
# SURFACESIGNAL_ANA_API_TOKEN=
# ANA_API_TOKEN=                      # accepted legacy alias

# The frontend has its own frontend/.env.local based on frontend/.env.example.
# NEVER place secrets into NEXT_PUBLIC_* configuration.
