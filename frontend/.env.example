# Public frontend defaults to committed compact JSON/GeoJSON without a .env.local.
# Copy to frontend/.env.local only to override the default mode.

# To use your own running read-only FastAPI server (matching backend CORS):
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Select an optional already-installed verified full static snapshot:
# NEXT_PUBLIC_STATIC_SNAPSHOT=full

# SEO canonical production URL (already the default):
# NEXT_PUBLIC_SITE_URL=https://surfacesignal.earth

# NEXT_PUBLIC_* variables are PUBLIC browser values. Never put tokens or secrets here.
