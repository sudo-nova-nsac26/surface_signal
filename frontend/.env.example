# Address of the SurfaceSignal backend (FastAPI), without a trailing slash.
# Leave it unset to read the committed compact snapshot in public/data/compact/api/v1.
# The backend must allow this site in SURFACESIGNAL_CORS_ORIGINS (root .env),
# for example ["http://localhost:3000"].
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional local full snapshot, installed and verified separately. Never needed
# for the public build; compact is the default. Public variables are not secrets.
# NEXT_PUBLIC_STATIC_SNAPSHOT=full
