# Address of the SurfaceSignal backend (FastAPI), without a trailing slash.
# Leave it unset to read the bundled snapshot in public/data/api/v1 instead.
# The backend must allow this site in SURFACESIGNAL_CORS_ORIGINS (root .env),
# for example ["http://localhost:3000"].
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
